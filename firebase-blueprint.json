{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile containing health information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "healthProfile": {
          "type": "object",
          "properties": {
            "age": { "type": "number" },
            "gender": { "type": "string" },
            "conditions": { "type": "string", "description": "Pre-existing medical conditions." },
            "allergies": { "type": "string", "description": "Known allergies." },
            "medications": { "type": "string", "description": "Currently taken medications." },
            "bloodType": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Session": {
      "title": "Session",
      "description": "A consultation session.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "timestamp": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "timestamp"]
    },
    "Message": {
      "title": "Message",
      "description": "A single message in a session.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "sessionId": { "type": "string" },
        "text": { "type": "string" },
        "analysis": { "type": "object" },
        "isUser": { "type": "boolean" },
        "timestamp": { "type": "integer" }
      },
      "required": ["userId", "sessionId", "isUser", "timestamp"]
    },
    "Medication": {
      "title": "Medication",
      "description": "A medication reminder for the user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string", "description": "Name of the medication." },
        "dosage": { "type": "string", "description": "Dosage amount (e.g., 500mg)." },
        "frequency": { "type": "string", "description": "How often to take (e.g., Daily, Twice a day)." },
        "times": { "type": "array", "items": { "type": "string" }, "description": "Specific times to take (e.g., 08:00, 20:00)." },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "notes": { "type": "string" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["userId", "name", "dosage", "frequency", "times", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents."
    },
    "/users/{userId}/medications/{medicationId}": {
      "schema": "Medication",
      "description": "User medication reminders."
    },
    "/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Session metadata."
    },
    "/sessions/{sessionId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Individual messages within a session."
    }
  }
}
